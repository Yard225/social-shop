{
  "name": "catalog-svc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/catalog-svc/src",
  "targets": {
    "build": {
      "executor": "@nx/node:build",
      "options": { "outputPath": "dist/services/catalog-svc" }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "services/catalog-svc/jest.config.js",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["scope:catalog", "type:service"]
} 